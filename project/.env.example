# Copy this file to project/.env. Never commit the real key.
SILICONFLOW_API_KEY=sk-your-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# OpenAI-compatible chat, embedding and rerank model identifiers.
LLM_MODEL=Qwen/Qwen3-8B
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3

# Milvus Standalone started by docker compose.
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=root:Milvus
MILVUS_COLLECTION=enterprise_knowledge_chunks_v2

# The Gradio UI and mock business tool share this backend address.
API_BASE_URL=http://127.0.0.1:8000
LOG_LEVEL=INFO
CONTEXT_TOKEN_BUDGET=6000
MAX_RETRIEVAL_ATTEMPTS=2
QUERY_REWRITE_ENABLED=true
PARENT_EXPANSION_ENABLED=true
MAX_UPLOAD_MB=20

# PostgreSQL is the authority for users, permissions, documents and conversations.
DATABASE_URL=postgresql+asyncpg://enterprise_rag:enterprise_rag@127.0.0.1:5432/enterprise_rag
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
AUTO_CREATE_SCHEMA=false

# Authentication and short-lived Redis state.
REDIS_URL=redis://127.0.0.1:6379/0
CONVERSATION_CACHE_TTL_SECONDS=1800
CONVERSATION_CACHE_MESSAGES=12
RETRIEVAL_CACHE_TTL_SECONDS=300
PERMISSION_CACHE_TTL_SECONDS=300
AUTH_KEY_ID=enterprise-rag-auth-v1
AUTH_RSA_KEY_SIZE=3072
AUTH_ACCESS_TOKEN_MINUTES=15
AUTH_REFRESH_TOKEN_DAYS=7
AUTH_JWT_ISSUER=enterprise-agentic-rag
AUTH_JWT_AUDIENCE=enterprise-agentic-rag-api
AUTH_DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001
AUTH_DEFAULT_TENANT_NAME=默认企业
AUTH_FIRST_USER_ADMIN=true

# Optional Langfuse tracing.
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com
